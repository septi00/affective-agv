<?xml version="1.0"?>
<package format="3">
  <name>proxemics_layer</name>
  <version>0.0.1</version>
  <description>Affect-modulated proxemics soft-cost layer for Nav2</description>
  <maintainer email="septi@example.com">Septimiu</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>pluginlib</depend>
  <depend>affective_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <nav2_costmap_2d plugin="${prefix}/proxemics_layer.xml" />
  </export>
</package>
