<?xml version="1.0"?>
<package format="2">
  <name>proxemics_layer_ros1</name>
  <version>0.0.1</version>
  <description>Affect-modulated proxemics soft-cost layer for costmap_2d / move_base</description>
  <maintainer email="septi@example.com">Septimiu</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>costmap_2d</depend>
  <depend>pluginlib</depend>
  <depend>affective_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <export>
    <costmap_2d plugin="${prefix}/proxemics_layer_plugin.xml" />
  </export>
</package>
